# VeraCost — Environment Configuration
# Prepared for NVIDIA & Nebius Token Factory Hackathon

PORT=3001

# Nebius Token Factory API Credentials
# Get your API key at: https://studio.nebius.ai/ or https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Verified Nebius Token Factory OpenAI-compatible Base URL
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Official NVIDIA Nemotron Model Identifier hosted on Nebius
# Options:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Recommended default)
# - nvidia/nemotron-4-340b-instruct
# - nvidia/nemotron-3-ultra-550b-a55b
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
