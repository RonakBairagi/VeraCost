# VeraCost — Environment Configuration
# Prepared for NVIDIA & Nebius Token Factory Hackathon

PORT=3001

# Nebius Token Factory API Credentials
# Get your API key at: https://studio.nebius.ai/ or https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Verified Nebius Token Factory OpenAI-compatible Base URL
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Official NVIDIA Nemotron Model Identifier hosted on Nebius
# Options:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Recommended default)
# - nvidia/nemotron-4-340b-instruct
# - nvidia/nemotron-3-ultra-550b-a55b
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Multimodal Vision Model for Visual Image Recognition (Optional)
# e.g., meta-llama/Llama-3.2-11B-Vision-Instruct
NEBIUS_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# Google Cloud Vision API (Optional — Free Tier provides first 1,000 units/month free)
# Documentation: https://docs.cloud.google.com/vision/docs
# If unconfigured, VeraCost seamlessly uses multimodal Nebius vision, verified catalog matching, and Google Lens.
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_key_here

# -------------------------------------------------------------
# Smart Price Finder — Indian Market Retailer Integrations (Optional)
# If unconfigured, VeraCost seamlessly uses verified benchmark datasets
# and authenticated direct store search gateways without simulated data.
# -------------------------------------------------------------

# Amazon India Product Advertising / RapidAPI Key
# Documentation: https://webservices.amazon.in/paapi5/documentation/
RAPIDAPI_AMAZON_KEY=your_rapidapi_amazon_key_here
AMAZON_IN_API_KEY=your_amazon_in_api_key_here

# Flipkart Affiliate API Credentials
# Documentation: https://affiliate.flipkart.com/api-docs
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token_here

# Croma Electronics Retailer API Key (Optional)
CROMA_API_KEY=your_croma_api_key_here

# Reliance Digital Electronics API Key (Optional)
RELIANCE_DIGITAL_API_KEY=your_reliance_digital_key_here

# Vijay Sales Store API Key (Optional)
VIJAY_SALES_API_KEY=your_vijay_sales_key_here

# Tata CLiQ Market API Key (Optional)
TATACLIQ_API_KEY=your_tatacliq_key_here

# Myntra Fashion & Wearables API Key (Optional)
MYNTRA_API_KEY=your_myntra_key_here

# Nykaa Beauty & Personal Care API Key (Optional)
NYKAA_API_KEY=your_nykaa_key_here

