{
  "name": "veracost-platform",
  "version": "1.0.0",
  "private": true,
  "description": "VeraCost — Transparent Total Cost of Ownership (TCO) Decision Platform powered by NVIDIA Nemotron via Nebius Token Factory",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase": "^13.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
